    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^24.0.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
